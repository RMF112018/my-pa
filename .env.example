# Example configuration for my-pa.
#
# Every value here is a non-secret default. Never add a credential, token,
# connection string, personal path, or NAS root to this file.
#
# Unknown MY_PA_ variables are rejected at startup rather than ignored, so a
# misspelled name fails loudly instead of leaving a default silently in place.

# Deployment environment: local | test
MY_PA_ENVIRONMENT=local

# Log verbosity: debug | info | warning | error
# Debug does not bypass redaction.
MY_PA_LOG_LEVEL=info

# Redaction of sensitive payloads. Must remain true; startup fails otherwise.
MY_PA_REDACTION_ENABLED=true

# Strict public-contract parsing, rejecting unknown fields.
# Must remain true; startup fails otherwise.
MY_PA_CONTRACT_STRICT_MODE=true

# Maximum page size the interface will honor (1-1000).
MY_PA_MAX_PAGE_SIZE=200

# Canonical PostgreSQL database. REQUIRED — there is no default. Must use the
# postgresql+psycopg scheme and name a host and a database; startup fails
# otherwise.
#
# It is required rather than defaulted on purpose. A default aimed every
# unconfigured process at the canonical my_pa database, including the migration
# CLI, which can run destructive operations. Absence now refuses to start
# instead of choosing a target for you.
#
# The value below targets the local my-pa-postgres container published on host
# port 5433 and deliberately carries no credential. Supply the password out of
# band with PGPASSWORD or ~/.pgpass. Never commit a value with one in it.
MY_PA_DATABASE_URL=postgresql+psycopg://my_pa@localhost:5433/my_pa
