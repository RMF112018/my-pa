# Example configuration for my-pa.
#
# Every value here is a non-secret default. Never add a credential, token,
# connection string, personal path, or NAS root to this file.
#
# Unknown MY_PA_ variables are rejected at startup rather than ignored, so a
# misspelled name fails loudly instead of leaving a default silently in place.

# Deployment environment: local | test
MY_PA_ENVIRONMENT=local

# Log verbosity: debug | info | warning | error
# Debug does not bypass redaction.
MY_PA_LOG_LEVEL=info

# Redaction of sensitive payloads. Must remain true; startup fails otherwise.
MY_PA_REDACTION_ENABLED=true

# Strict public-contract parsing, rejecting unknown fields.
# Must remain true; startup fails otherwise.
MY_PA_CONTRACT_STRICT_MODE=true

# Maximum page size the interface will honor (1-1000).
# The value capabilities.get publishes is the smaller of this and the bound the
# search domain enforces, because a published maximum that is not enforced is
# not a maximum.
MY_PA_MAX_PAGE_SIZE=200

# Page size used when a request names none (1-1000, and not above
# MY_PA_MAX_PAGE_SIZE; startup fails if it is).
MY_PA_DEFAULT_PAGE_SIZE=50

# Most bytes one sources.fetch may read from a single object (1-16777216).
# The ceiling is four bytes per extractable character: past it, no additional
# byte can belong to a document this build could extract.
MY_PA_MAX_FETCH_BYTES=8388608

# Deepest recursion an enrollment may request (0-8). Zero means the named root
# and its immediate children, never a walk. Configuration may lower the domain
# ceiling and may not raise it.
MY_PA_MAX_ENROLLMENT_DEPTH=0

# How the HTTP transport establishes the acting Principal: local_operator | entra
#
# local_operator is the default and is the behaviour this build has always had:
# loopback is the trust boundary, the process acts as one durable local
# operator, and no credential is issued, read, or required.
#
# entra requires Authorization: Bearer <token> on every request, verifies it
# (RS256, against the issuer's published keys), and derives the Principal from
# the token's validated tid/oid claims. Turning it on is a configuration change
# and nothing else — no code changes, and no code has to.
#
# There is no inference and no downgrade. entra without all four values below
# fails startup rather than falling back to local_operator, because a missing
# variable that silently served every request as the local operator is the one
# failure this setting exists to prevent.
MY_PA_AUTH_MODE=local_operator

# Whether the authenticated remote capture ingress serves at all.
#
# Off by default, and off is the fail-closed direction: an unset variable, a typo
# in the name, or a .env nobody loaded all produce a process that serves no
# remote ingress. The route is still mounted and still answers — with 501, before
# it reads a credential or a body — so "disabled" is a refusal a request meets
# rather than an address that quietly is not there.
#
# Turning it on does NOT publish anything. The gateway binds 127.0.0.1 as a
# constant with no flag, so an enabled ingress answers on loopback and nowhere
# else. Terminating TLS and reaching it from a phone needs a proxy or a tunnel
# the operator runs; nothing in this repository does that, and doing it is an
# operator decision under AGENTS.md section 8.2.
#
# Clients are minted with apps/cli/clients.py register, which prints the
# credential once and stores only a SHA-256 digest of it. Nothing here holds one.
MY_PA_REMOTE_INGRESS_ENABLED=false

# Where the managed-document write plane stores bytes (WP-27). BLANK HERE ON
# PURPOSE, and blank means there is no managed plane: a process that has not been
# told where managed bytes go composes no byte store and can write no managed
# document. There is no default location, because choosing where a user's
# documents live is an operator decision and a default would put one in whatever
# directory a process happened to start in.
#
# The root must already exist, must be a real directory rather than a symbolic
# link, and must not be, contain, or sit inside a configured read-only source
# root — the store refuses all four at construction, after resolving both sides.
# Source roots are knowledge.sources rows registered with apps/cli/sources.py;
# this is process configuration, so the two cannot be one value.
#
# No credential accompanies it. The store is a local filesystem reached with the
# process's own identity, so there is nothing to hold; a remote managed store
# would carry its own MY_PA_MANAGED_DOCUMENT_* credential and standing one up is
# an operator-gated action.
#
# ops/runbooks/managed-document-operations.md covers verify, backup and restore.
MY_PA_MANAGED_DOCUMENT_ROOT=

# The four values entra mode requires. All four are blank here on purpose: this
# repository is public, and a live tenant, application registration, or issuer
# is an operator-supplied runtime value that is never committed. None of them is
# a secret — anyone holding a token already knows all four — but a real tenant
# ID identifies an organization and does not belong in a tracked file.
#
# Home tenant (the only tenant whose tokens are accepted). A token from any
# other tenant is denied before any store is reached.
MY_PA_ENTRA_TENANT_ID=
# Application (client) ID of this API's own registration; the audience every
# accepted token must carry.
MY_PA_ENTRA_CLIENT_ID=
# Exact issuer the token must declare, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0
MY_PA_ENTRA_ISSUER=
# Where the issuer publishes its signing keys, e.g.
# https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
MY_PA_ENTRA_JWKS_URI=

# Canonical PostgreSQL database. REQUIRED — there is no default. Must use the
# postgresql+psycopg scheme and name a host and a database; startup fails
# otherwise.
#
# It is required rather than defaulted on purpose. A default aimed every
# unconfigured process at the canonical my_pa database, including the migration
# CLI, which can run destructive operations. Absence now refuses to start
# instead of choosing a target for you.
#
# The value below targets the local my-pa-postgres container published on host
# port 5433 and deliberately carries no credential. Supply the password out of
# band with PGPASSWORD or ~/.pgpass. Never commit a value with one in it.
MY_PA_DATABASE_URL=postgresql+psycopg://my_pa@localhost:5433/my_pa
