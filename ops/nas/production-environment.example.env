# COPY OUTSIDE GIT.
# Placeholder production environment for https://pa.bobby-fetting.me.
# Every secret is fake and at least 32 characters. Replace on the NAS only.
# Never commit live secrets, credentials.json, or a filled copy of this file.
#
# Browser production auth is passkey. Gateway transport may remain local_operator.
# There is no caller-configurable Principal variable. The production Principal is
# the fixed LOCAL_OPERATOR_UUID, not an env-selected identity.
# Expected Alembic head for operator assertions: 4e9a1c7b2d60
# BFF/Python session-service secrets must match. BFF/Python WebAuthn secrets must
# match. Validators compare those pairs without printing either value.

NODE_ENV=production
MYPA_AUTH_MODE=passkey
MYPA_CANONICAL_ORIGIN=https://pa.bobby-fetting.me
MYPA_GATEWAY_URL=http://gateway:8765
MYPA_GATEWAY_AUTH_MODE=local_operator
# MYPA_SESSION_SERVICE_URL must be absent or empty in production.

# Session-service pair: identical placeholder values; replace both together.
MYPA_SESSION_SERVICE_SECRET=REPLACE_ME_FAKE_SESSION_SERVICE_SECRET_00
MY_PA_SESSION_SERVICE_SECRET=REPLACE_ME_FAKE_SESSION_SERVICE_SECRET_00
# WebAuthn pair: identical to each other, distinct from the session-service pair.
MYPA_WEBAUTHN_BFF_SECRET=REPLACE_ME_FAKE_WEBAUTHN_BFF_SECRET_000000
MY_PA_WEBAUTHN_BFF_SECRET=REPLACE_ME_FAKE_WEBAUTHN_BFF_SECRET_000000

MY_PA_WEBAUTHN_RP_ID=pa.bobby-fetting.me
MY_PA_WEBAUTHN_RP_NAME=my-pa
MY_PA_WEBAUTHN_ALLOWED_ORIGINS=https://pa.bobby-fetting.me

MY_PA_DB_PASSWORD=REPLACE_ME_FAKE_POSTGRES_PASSWORD_32CHARS

MY_PA_APP_IMAGE_ID=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MY_PA_WEB_IMAGE_ID=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
MY_PA_POSTGRES_IMAGE_ID=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
MY_PA_PROXY_IMAGE=caddy
MY_PA_PROXY_IMAGE_DIGEST=sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

MY_PA_UID=10001
MY_PA_GID=10001
MY_PA_PROXY_UID=10002
MY_PA_PROXY_GID=10002
MY_PA_NAS_ROOT=/volume1/my-pa
MY_PA_NAS_ENV_FILE=/volume1/my-pa/secrets/nas.env
MY_PA_WEB_ENV_FILE=/volume1/my-pa/secrets/web.env

MY_PA_FRONTEND_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
MY_PA_FRONTEND_CLOUDFLARED_CONFIG=/volume1/my-pa/frontend-cloudflared/config.yml
MY_PA_FRONTEND_CLOUDFLARED_CREDENTIALS_DIR=/volume1/my-pa/secrets/frontend-cloudflared
MY_PA_FRONTEND_CLOUDFLARED_UID=65532
MY_PA_FRONTEND_CLOUDFLARED_GID=65532

MYPA_SOURCE_COMMIT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MYPA_SOURCE_TREE=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
