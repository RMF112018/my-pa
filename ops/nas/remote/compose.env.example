# Non-secret Compose interpolation example. Copy outside Git and replace every
# REQUIRED value. Image references must resolve to exact sha256 digests.
MY_PA_APP_IMAGE_ID=registry.example.invalid/my-pa@sha256:REQUIRED_64_HEX_DIGEST
MY_PA_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf
MY_PA_REMOTE_UID=10001
MY_PA_REMOTE_GID=10001
MY_PA_CLOUDFLARED_UID=65532
MY_PA_CLOUDFLARED_GID=65532
MY_PA_REMOTE_CPU_SHARES=1024
MY_PA_REMOTE_MEMORY=768m
MY_PA_CLOUDFLARED_CPU_SHARES=512
MY_PA_CLOUDFLARED_MEMORY=256m
MY_PA_DATA_NETWORK=my-pa-nas-contract_data-plane
MY_PA_NAS_CONFIG_ROOT=/volume1/my-pa/config
MY_PA_NAS_SOURCE_ROOT=/volume1/my-pa/sources
MY_PA_NAS_MANAGED_ROOT=/volume1/my-pa/managed-documents
MY_PA_REMOTE_ENV_FILE=/volume1/my-pa/secrets/mcp-remote.env
MY_PA_CLOUDFLARED_CONFIG=/volume1/my-pa/cloudflared/config.yml
MY_PA_CLOUDFLARED_CREDENTIALS_DIR=/volume1/my-pa/secrets/cloudflared
MY_PA_REMOTE_LOOPBACK_PORT=8766
