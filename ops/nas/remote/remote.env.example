# Copy outside Git, chmod 600, and provide it as MY_PA_REMOTE_ENV_FILE.
# Values here are non-secret examples only. Generate the operator secret directly
# into the owner-only deployed copy; never print or commit it.
MY_PA_DATABASE_URL=postgresql+psycopg://my_pa:REQUIRED_DATABASE_PASSWORD@postgres:5432/my_pa
MY_PA_AUTH_MODE=local_operator
MY_PA_REMOTE_MCP_ENABLED=true
MY_PA_REMOTE_WRITES_ENABLED=false
MY_PA_REMOTE_MCP_PUBLIC_HOST=mcp.example.invalid
MY_PA_OAUTH_AUDIENCE=https://mcp.example.invalid/mcp
MY_PA_OAUTH_AUTHORIZATION_SERVER=https://mcp.example.invalid
MY_PA_OAUTH_SCOPES=my-pa.read
MY_PA_OAUTH_OPERATOR_SECRET=
MY_PA_MCP_SURFACE_DISABLED=false
MY_PA_REDACTION_ENABLED=true
MY_PA_CONTRACT_STRICT_MODE=true
