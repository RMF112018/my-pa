# Copy outside Git, chmod 600, and provide it as MY_PA_REMOTE_ENV_FILE.
# Values here are non-secret examples only. Required identity values intentionally
# use RFC 2606 .invalid names and must be replaced.
MY_PA_DATABASE_URL=postgresql+psycopg://my_pa:REQUIRED_DATABASE_PASSWORD@postgres:5432/my_pa
MY_PA_REMOTE_MCP_ENABLED=true
MY_PA_REMOTE_WRITES_ENABLED=false
MY_PA_REMOTE_MCP_PUBLIC_HOST=mcp.example.invalid
MY_PA_OAUTH_ISSUER=https://issuer.example.invalid/v2.0
MY_PA_OAUTH_AUDIENCE=https://mcp.example.invalid
MY_PA_OAUTH_JWKS_URI=https://issuer.example.invalid/keys
MY_PA_OAUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
MY_PA_OAUTH_AUTHORIZATION_SERVER=https://issuer.example.invalid
MY_PA_OAUTH_SCOPES=my-pa.read
MY_PA_MCP_SURFACE_DISABLED=false
MY_PA_REDACTION_ENABLED=true
MY_PA_CONTRACT_STRICT_MODE=true
