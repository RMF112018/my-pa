{
  "_comment": "Golden vectors of the record lineage S4 report-manifest encodings (S4 contract sections 5.2 and 5.3). Generated once from the canonical encoder and reviewed by hand: sorted keys, compact separators, every non-printable or non-ASCII character escaped (DEL as \\u007f), instants as %Y-%m-%dT%H:%M:%S.%fZ. Every digest is SHA-256 over the domain separator and the expected text. Unit vectors use integers, strings and already-normal floats only (section 5.2, R4-F12). All identifiers are synthetic.",
  "structured_content": [
    {
      "name": "integers_strings_booleans_and_null",
      "input": {
        "b": [
          true,
          null,
          "x"
        ],
        "a": 1
      },
      "expected_canonical": "{\"a\":1,\"b\":[true,null,\"x\"]}",
      "expected_sha256": "8123bbe4615974175c864d49c949220a91e970dec90ac0799bc9c8f517b0a1a9"
    },
    {
      "name": "an_already_normal_float",
      "input": {
        "ratio": 0.5,
        "count": 100,
        "nested": {
          "z": -2.25,
          "a": 1e-07
        }
      },
      "expected_canonical": "{\"count\":100,\"nested\":{\"a\":1e-07,\"z\":-2.25},\"ratio\":0.5}",
      "expected_sha256": "6c3f116125036aba4dca18c0276296ff47e2fbadb292cd0033cc361ca5dbb0d9"
    },
    {
      "name": "a_non_ascii_string",
      "input": {
        "title": "Caf\u00e9 \u2013 \u0394 \ud83d\ude00"
      },
      "expected_canonical": "{\"title\":\"Caf\\u00e9 \\u2013 \\u0394 \\ud83d\\ude00\"}",
      "expected_sha256": "5c865ca451dbdaaed848ec4d0e68d285fadc74f33ae42a3274414f89e4cc3876"
    },
    {
      "name": "control_characters_and_del",
      "input": {
        "ref": "a\u0001b\u007fc\nd"
      },
      "expected_canonical": "{\"ref\":\"a\\u0001b\\u007fc\\nd\"}",
      "expected_sha256": "b0d1d1494da3a860b8417906155e8d64800e57e5f26025e1f77ee38612ccadda"
    }
  ],
