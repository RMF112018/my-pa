# Example configuration for the my-pa web tier.
#
# Every value here is a non-secret placeholder. Never add a credential, token,
# tenant identifier, connection string, or personal path to this file.
#
# None of these has a default. An unset value is a refusal that reaches an
# operator, not a guess that picks the permissive branch — see web/README.md.

# The HMAC key signing the session cookie. At least 32 characters.
# Generate one out of band: openssl rand -hex 32
# Left blank here deliberately: a committed default would be a signing key
# anyone could mint a session with.
MYPA_SESSION_SECRET=

# How this shell authenticates a person: synthetic | local_operator | entra
# synthetic is the two fixed development principals and is refused outright when
# NODE_ENV=production. entra is real sign-in and additionally requires
# MYPA_ENTRA_HOME_TENANT_ID; no live Entra registration is configured anywhere in
# this repository, and creating one is operator-gated.
MYPA_AUTH_MODE=synthetic

# Owner-only local credential used only when MYPA_AUTH_MODE=local_operator.
# Generate 43-128 URL-safe characters directly into the deployed secret file.
MYPA_LOCAL_OPERATOR_SECRET=

# The tenant whose tokens this deployment accepts. Required in entra mode.
MYPA_ENTRA_HOME_TENANT_ID=

# Where the Python gateway is. Absolute http(s) URL, no default at all.
# This is the backend the BFF speaks POST /v1/{capability} to; without it the
# routes that have a backend capability refuse with `gateway_not_configured`
# rather than falling back to fixture data.
MYPA_GATEWAY_URL=http://127.0.0.1:8000

# How the gateway on the other end establishes its acting Principal:
# local_operator | entra. Mirrors MY_PA_AUTH_MODE in the repository-root
# .env.example and must agree with it.
#
# local_operator: no credential is sent and the gateway serves its fixed process
#   principal. Results are that one principal's and are NOT partitioned by
#   browser session; every disclosure says so.
# entra: the gateway requires a bearer token. A completed server-side Entra
#   callback holds it outside the browser session cookie. Without that completed
#   flow the BFF refuses rather than sending unauthenticated or fabricating one.
MYPA_GATEWAY_AUTH_MODE=local_operator

# The synthetic data provider. UNSET BY DEFAULT, and unset means off.
#
# Set to exactly `synthetic` to serve fixture data on the surfaces that have
# fixtures. Refused in a production build. Any other value is refused rather
# than treated as unset, so a typo is visible instead of silently safe.
#
# Leave it out of a real deployment. With it unset, no route and no page can
# produce fixture data at all: the fixture functions themselves refuse.
# MYPA_DATA_PROVIDER=synthetic

# The application's own API scope, when an Entra app registration exists.
# A value naming Microsoft Graph is dropped rather than honoured.
MYPA_ENTRA_API_SCOPE=

# Node-only MSAL authorization-code configuration. Blank in the repository and
# inert until the operator supplies a complete live registration out of band.
MYPA_ENTRA_CLIENT_ID=
MYPA_ENTRA_CLIENT_SECRET=
MYPA_ENTRA_REDIRECT_URI=
