{
  "_comment": [
    "The cross-tier request contract for POST /v1/{capability} on the Python gateway.",
    "This file is read by BOTH tiers and is the single place either may learn the",
    "shape of a request. web/src/lib/api/gateway.ts imports it and builds every",
    "document from it; tests/contract/test_bff_gateway_contract_parity.py loads the",
    "same bytes and checks every entry against my_pa.domain.identity.operation,",
    "my_pa.contracts.v1.envelope, my_pa.adapters.normalization and the command",
    "dataclasses, then feeds each `probe` through normalize() to prove acceptance.",
    "A hand-copied fixture on either side would drift silently; this cannot, because",
    "there is only one copy and both ends fail when it stops matching.",
    "Every value here is synthetic. No tenant, credential, path, or personal datum."
  ],
  "contractVersion": "v1",
  "pathTemplate": "/v1/{capability}",
  "payloadKey": "payload",
  "routedField": "capability",
  "envelopeFields": [
    "contract_version",
    "request_id",
    "purpose",
    "principal_id",
    "requested_at"
  ],
  "capabilities": {
    "capabilities.get": {
      "purpose": "status_observation",
      "payloadFields": [],
      "probe": {}
    },
    "knowledge.search": {
      "purpose": "knowledge_search",
      "payloadFields": ["enrollment_id", "query", "page_size", "cursor", "snippet_words"],
      "probe": { "enrollment_id": "enr_aaaaaaaa11111111", "query": "concrete pour" }
    },
    "knowledge.read": {
      "purpose": "knowledge_read",
      "payloadFields": ["knowledge_id", "enrollment_id", "metadata_only", "max_characters"],
      "probe": { "knowledge_id": "kn_aaaaaaaa11111111", "enrollment_id": "enr_aaaaaaaa11111111" }
    },
    "knowledge.reveal": {
      "purpose": "capture_review",
      "payloadFields": ["subject_id"],
      "probe": { "subject_id": "cap_aaaaaaaa11111111" }
    },
    "capture.create": {
      "purpose": "capture_authoring",
      "payloadFields": [
        "text",
        "idempotency_key",
        "capture_kind",
        "context_source_object_id",
        "context_source_version_id",
        "client_created_at",
        "occurred_at"
      ],
      "probe": { "text": "a synthetic capture", "idempotency_key": "idem-probe-0001" }
    },
    "capture.list": {
      "purpose": "capture_review",
      "payloadFields": ["page_size"],
      "probe": { "page_size": 25 }
    },
    "capture.search": {
      "purpose": "capture_review",
      "payloadFields": ["query", "page_size"],
      "probe": { "query": "concrete pour", "page_size": 25 }
    },
    "review.list": {
      "purpose": "capture_review",
      "payloadFields": ["page_size", "subject_kind", "state", "entity_id", "after"],
      "probe": { "page_size": 25 }
    },
    "review.decide": {
      "purpose": "review_disposition",
      "payloadFields": [
        "review_case_id",
        "expected_review_version",
        "disposition",
        "corrected_value",
        "correction_patch",
        "reason"
      ],
      "probe": {
        "review_case_id": "rvw_aaaaaaaa11111111",
        "expected_review_version": 0,
        "disposition": "accept"
      }
    },
    "continuity.pulse": {
      "purpose": "capture_review",
      "payloadFields": [],
      "probe": {}
    },
    "continuity.situations": {
      "purpose": "capture_review",
      "payloadFields": ["page_size"],
      "probe": {}
    },
    "continuity.projects": {
      "purpose": "capture_review",
      "payloadFields": ["page_size"],
      "probe": {}
    },
    "tasks.read": {
      "purpose": "task_read",
      "payloadFields": ["task_id"],
      "probe": { "task_id": "tsk_aaaaaaaa11111111" }
    },
    "tasks.list": {
      "purpose": "task_read",
      "payloadFields": ["lifecycle_state", "priority", "archive_mode", "page_size", "after", "work_view", "work_date", "timezone"],
      "probe": { "page_size": 25 }
    },
    "tasks.search": {
      "purpose": "task_read",
      "payloadFields": ["query", "page_size", "after", "work_view", "work_date", "timezone", "archive_mode"],
      "probe": { "query": "synthetic follow up", "page_size": 25 }
    },
    "tasks.history": {
      "purpose": "task_read",
      "payloadFields": ["task_id", "page_size", "after"],
      "probe": { "task_id": "tsk_aaaaaaaa11111111", "page_size": 25 }
    },
    "tasks.create": {
      "purpose": "task_authoring",
      "payloadFields": ["title", "origin_evidence_ref", "idempotency_key", "description", "priority", "due_at", "project_id", "situation_id", "accepted_by_review_decision_id", "commitment_id", "role", "client_context"],
      "probe": { "title": "Synthetic task", "origin_evidence_ref": "cap_aaaaaaaa11111111", "idempotency_key": "idem-task-create-0001" }
    },
    "tasks.update": {
      "purpose": "task_authoring",
      "payloadFields": ["task_id", "expected_version", "idempotency_key", "title", "description", "priority", "due_at", "scheduled_at", "deferred_until", "commitment_id", "role", "clear_fields", "archived", "client_context"],
      "probe": { "task_id": "tsk_aaaaaaaa11111111", "expected_version": 1, "idempotency_key": "idem-task-update-0001", "title": "Updated synthetic task" }
    },
    "tasks.transition": {
      "purpose": "task_authoring",
      "payloadFields": ["task_id", "to_state", "expected_version", "idempotency_key", "closure_evidence_ref", "client_context"],
      "probe": { "task_id": "tsk_aaaaaaaa11111111", "to_state": "in_progress", "expected_version": 1, "idempotency_key": "idem-task-transition-0001" }
    },
    "tasks.bulk_preview": {
      "purpose": "task_authoring",
      "payloadFields": ["mutations", "idempotency_key"],
      "probe": { "mutations": [{ "kind": "update", "task_id": "tsk_aaaaaaaa11111111", "expected_version": 1, "values": { "priority": "p1" }, "clear_fields": [] }], "idempotency_key": "idem-task-bulk-preview-0001" }
    },
    "tasks.bulk_confirm": {
      "purpose": "task_authoring",
      "payloadFields": ["bulk_operation_id", "idempotency_key", "mutations"],
      "probe": { "bulk_operation_id": "bulk_aaaaaaaa11111111", "idempotency_key": "idem-task-bulk-confirm-0001", "mutations": [{ "kind": "update", "task_id": "tsk_aaaaaaaa11111111", "expected_version": 1, "values": { "priority": "p1" }, "clear_fields": [] }] }
    },
    "commitments.read": {
      "purpose": "commitment_read",
      "payloadFields": ["commitment_id"],
      "probe": { "commitment_id": "cmt_aaaaaaaa11111111" }
    },
    "commitments.list": {
      "purpose": "commitment_read",
      "payloadFields": ["direction", "state", "page_size", "after", "work_view", "work_date", "timezone"],
      "probe": { "page_size": 25 }
    },
    "commitments.search": {
      "purpose": "commitment_read",
      "payloadFields": ["query", "page_size", "after", "direction", "state", "work_view", "work_date", "timezone"],
      "probe": { "query": "synthetic commitment", "page_size": 25 }
    },
    "commitments.history": {
      "purpose": "commitment_read",
      "payloadFields": ["commitment_id", "page_size", "after"],
      "probe": { "commitment_id": "cmt_aaaaaaaa11111111", "page_size": 25 }
    },
    "commitments.waiting_on": {
      "purpose": "commitment_read",
      "payloadFields": ["page_size", "after"],
      "probe": { "page_size": 25 }
    },
    "commitments.create": {
      "purpose": "commitment_authoring",
      "payloadFields": ["counterparty_person_id", "direction", "summary", "origin_evidence_ref", "idempotency_key", "due_at", "project_id", "situation_id", "accepted_by_review_decision_id", "client_context"],
      "probe": { "counterparty_person_id": "per_aaaaaaaa11111111", "direction": "owed_to_principal", "summary": "Synthetic commitment", "origin_evidence_ref": "cap_aaaaaaaa11111111", "idempotency_key": "idem-commitment-create-0001" }
    },
    "commitments.update": {
      "purpose": "commitment_authoring",
      "payloadFields": ["commitment_id", "expected_version", "idempotency_key", "summary", "due_at", "counterparty_person_id", "clear_due_at", "client_context"],
      "probe": { "commitment_id": "cmt_aaaaaaaa11111111", "expected_version": 1, "idempotency_key": "idem-commitment-update-0001", "summary": "Updated synthetic commitment" }
    },
    "commitments.close": {
      "purpose": "commitment_authoring",
      "payloadFields": ["commitment_id", "expected_version", "closure_evidence_ref", "idempotency_key", "client_context"],
      "probe": { "commitment_id": "cmt_aaaaaaaa11111111", "expected_version": 1, "closure_evidence_ref": "cap_aaaaaaaa11111111", "idempotency_key": "idem-commitment-close-0001" }
    }
  },
  "_dispositionComment": [
    "The workbench's disposition vocabulary is not the domain's. Two verbs are",
    "spelled differently on each side, and this map is the only place the",
    "translation exists. The parity test asserts every value is a member of",
    "my_pa.domain.capture.review.Disposition, so a rename on either side is a",
    "failure rather than a request the gateway refuses in the field."
  ],
  "dispositions": {
    "accept": "accept",
    "correct": "correct_and_accept",
    "reject": "reject",
    "defer": "defer",
    "unresolved": "mark_unresolved"
  }
}
