  "_dispositionComment": [
    "The workbench's disposition vocabulary is not the domain's. Two verbs are",
    "spelled differently on each side, and this map is the only place the",
    "translation exists. The parity test asserts every value is a member of",
    "my_pa.domain.capture.review.Disposition, so a rename on either side is a",
    "failure rather than a request the gateway refuses in the field."
  ],
  "dispositions": {
    "accept": "accept",
    "correct": "correct_and_accept",
    "reject": "reject",
    "defer": "defer",
    "unresolved": "mark_unresolved"
  }
